# Backend application settings
APP_NAME=Rheumatological Disease Portal
DEBUG=false
# Frontend (nginx)
# Max request body size, e.g. for file uploads
NGINX_CLIENT_MAX_BODY_SIZE=100m
# Backend address proxied under /api/ (HTTP and WebSocket)
NGINX_BACKEND_URL=http://server:8000
# DNS resolver used to look up the backend (127.0.0.11 is Docker's embedded DNS)
NGINX_RESOLVER=127.0.0.11

# Backend Host header: hostnames/IPs without scheme, port or path
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Frontend origins: exact scheme + hostname + port, without trailing slash
CORS__ALLOW_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS__ALLOW_METHODS=["GET"]
CORS__ALLOW_HEADERS=["Content-Type","Authorization"]
CORS__ALLOW_CREDENTIALS=false
CORS__EXPOSE_HEADERS=[]
CORS__MAX_AGE=600

# PostgreSQL: localhost/host port for local uv commands
# Compose overrides the backend's connection to postgres:5432 inside its network
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__NAME=rheumatology
DATABASE__USER=rheumatology
# Example for local development only; set your own value in .env
DATABASE__PASSWORD=local_dev_password
DATABASE__CONNECT_TIMEOUT=5

# Host port for backend access; containers always use server:8000
BACKEND_PORT=8000

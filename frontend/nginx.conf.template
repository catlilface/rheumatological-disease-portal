# Rendered by the nginx image entrypoint (envsubst) from
# /etc/nginx/templates/default.conf.template to /etc/nginx/conf.d/default.conf.
# Only variables defined in the environment are substituted, so nginx
# variables such as $uri stay untouched.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

  # Resolve the BFF at request time using the container's DNS.
  resolver ${NGINX_RESOLVER} valid=30s ipv6=off;
  resolver_timeout 5s;

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # BFF mounts /_demo/delivery only in the optional delivery stand.
  location ~ ^/(api|scalar|_demo/delivery)(/|$) {
    set $backend ${NGINX_BACKEND_URL};
    set $portal_origin "${NGINX_PUBLIC_ORIGIN}";
    if ($portal_origin = '') {
      set $portal_origin $scheme://$http_host;
    }

    # Only a request from the portal origin can inherit the upstream origin.
    set $backend_origin '';
    if ($http_origin = $portal_origin) {
      set $backend_origin $backend;
    }
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $proxy_host;
    proxy_set_header Origin $backend_origin;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_connect_timeout 10s;
    proxy_send_timeout 3600s;
    proxy_read_timeout 3600s;

    # Stream responses to the client as they arrive
    proxy_buffering off;
    proxy_request_buffering off;
  }

  location ~ ^/policy/[a-z-]+/?$ {
    rewrite ^(/policy/[a-z-]+)/?$ $1.pdf last;
  }

  location /policy/ {
    add_header Cache-Control "no-cache";
    try_files $uri =404;
  }

  # SPA fallback: client-side routes are served by index.html
  location / {
    absolute_redirect off;
    # Match the original URI so percent-encoding and the query stay intact.
    if ($request_uri ~ "^(/[^/?\x5c](?:[^?\x5c]*[^/?\x5c])?)/+(\?.*)?$") {
      return 301 $1$2;
    }
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}

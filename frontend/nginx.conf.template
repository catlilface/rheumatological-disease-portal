# Rendered by the nginx image entrypoint (envsubst) from
# /etc/nginx/templates/default.conf.template to /etc/nginx/conf.d/default.conf.
# Only variables defined in the environment are substituted, so nginx
# variables such as $uri stay untouched.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

  # Docker DNS; lets nginx start even when the backend is not running yet
  resolver ${NGINX_RESOLVER} valid=30s ipv6=off;

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # Backend API with WebSocket support (e.g. streaming LLM output)
  location /api/ {
    set $backend ${NGINX_BACKEND_URL};
    proxy_pass $backend;
    proxy_http_version 1.1;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_connect_timeout 10s;
    proxy_send_timeout 3600s;
    proxy_read_timeout 3600s;

    # Stream responses to the client as they arrive
    proxy_buffering off;
    proxy_request_buffering off;
  }

  # SPA fallback: client-side routes are served by index.html
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
